# Base de datos en supabase 
# ======== INSTRUCCIONES DEFINITIVAS DE CONEXIÓN (2025) ========
# El error "Tenant or user not found" confirma que la conexión sale de tu PC,
# pero está llegando a la REGIÓN de Supabase equivocada.

# PARA OBTENER LOS DATOS EXACTOS EN TU DASHBOARD:
# 1. Entra a tu proyecto en Supabase: https://supabase.com/dashboard/project/hhazotxzoehoqxcoaadd
# 2. Mira arriba a la derecha: Hay un botón verde que dice "Connect". Clica ahí.
# 3. En la ventana que se abre, ve a la pestaña "Transaction Mode" (o "Session Mode").
# 4. Asegúrate de que "Use connection pooling" esté marcado.
# 5. Copia los valores que aparecen ahí para "Host", "User" y "Port".

# --- Configuración (Reemplaza con lo que copiaste del botón "Connect") ---

# El Host debe lucir algo como: aws-0-[REGION].pooler.supabase.com
# Ejemplo Región USA: aws-0-us-east-1.pooler.supabase.com
# Ejemplo Región UE: eur-0-eu-central-1.pooler.supabase.com
DB_HOST=aws-1-us-east-2.pooler.supabase.com

# El Puerto del Pooler es casi siempre 6543 (Transaction) o 5432 (Session)
DB_PORT=6543

# El Usuario ¡IMPORTANTE!: En el Pooler es: postgres.[reference_id]
# Verifica en el botón "Connect" si tu usuario es 'postgres.hhazotxzoehoqxcoaadd'
DB_USER=postgres.hhazotxzoehoqxcoaadd

# Tu contraseña de base de datos (Esa no cambia)
DB_PASS=2YZgYMcIJwGCDoUJ

# String de conexión completo (Construido con los datos de arriba)
DATABASE_URL=postgresql://postgres.hhazotxzoehoqxcoaadd:2YZgYMcIJwGCDoUJ@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# --- Configuración General del Proyecto ---
DB_NAME=postgres
SECRET_KEY=Zonadpr
MP_ACCESS_TOKEN_V=APP_USR-6465228858602721-090414-40e628c89ba909993b7bbc542a539592-1976283798
JWT_SECRET=Zonadpr
NODE_ENV=production
PORT=5000
